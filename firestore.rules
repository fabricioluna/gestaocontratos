rules_version = '2';

// Espelha o que está publicado hoje no console (ver docs/PLANO.md, Fase 0
// e Decisões já tomadas nº 4): autenticação sem autorização real para
// contratos/itens até a Fase 3 trazer os custom claims. A única correção
// desta fase é fechar auditoria_logs, que hoje cai no "if false" global
// e deixa o log de auditoria 100% inoperante.
service cloud.firestore {
  match /databases/{database}/documents {
    match /contratos/{contratoId} {
      allow read, write: if request.auth != null;
    }

    match /itens/{itemId} {
      allow read, write: if request.auth != null;
    }

    // Qualquer usuário autenticado pode gravar seu próprio log (é como o
    // registrarLog atual funciona, direto do cliente) — mas só em nome de
    // si mesmo: sem isso, o campo "usuario" viria do cliente sem checagem
    // nenhuma, e qualquer conta autenticada poderia forjar entradas em
    // nome de outra pessoa num registro que existe justamente para
    // responsabilização. Ninguém lê, altera ou apaga — a tela de consulta
    // fica para o backlog da Fase 8.
    match /auditoria_logs/{logId} {
      allow create: if request.auth != null
        && request.resource.data.usuario == request.auth.token.email;
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
