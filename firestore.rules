rules_version = '2';

// Fase 3: autorização real por custom claims (perfil + orgaoId), atribuídos
// via /api/definir-perfil e lidos aqui em request.auth.token. Substitui a
// regra "autenticação sem autorização" das Fases 0-2 (ver docs/PLANO.md).
service cloud.firestore {
  match /databases/{database}/documents {

    function ehAdmin() {
      return request.auth != null && request.auth.token.perfil == 'admin';
    }

    function orgaoDoToken() {
      return request.auth.token.orgaoId;
    }

    match /contratos/{contratoId} {
      // Admin só vê contratos do próprio órgão; fiscal (viewer) só vê o
      // contrato em que ele é o e-mail da secretaria/fiscal responsável.
      allow read: if request.auth != null && (
        (ehAdmin() && resource.data.orgaoId == orgaoDoToken()) ||
        resource.data.emailSecretaria == request.auth.token.email
      );

      allow create: if ehAdmin() && request.resource.data.orgaoId == orgaoDoToken();

      // Update não pode mudar o orgaoId do contrato — isso equivaleria a
      // transferi-lo para outro órgão sem controle nenhum.
      allow update: if ehAdmin() && resource.data.orgaoId == orgaoDoToken()
        && request.resource.data.orgaoId == resource.data.orgaoId;

      allow delete: if ehAdmin() && resource.data.orgaoId == orgaoDoToken();
    }

    match /itens/{itemId} {
      // itens não carregam orgaoId/emailSecretaria próprios — a regra busca
      // o contrato pai (contratoId) para decidir. Custo de uma leitura
      // extra por item, aceito nesta fase (ver docs/PLANO.md).
      allow read: if request.auth != null && (
        (ehAdmin() && get(/databases/$(database)/documents/contratos/$(resource.data.contratoId)).data.orgaoId == orgaoDoToken()) ||
        get(/databases/$(database)/documents/contratos/$(resource.data.contratoId)).data.emailSecretaria == request.auth.token.email
      );

      allow create: if ehAdmin()
        && get(/databases/$(database)/documents/contratos/$(request.resource.data.contratoId)).data.orgaoId == orgaoDoToken();

      allow update, delete: if ehAdmin()
        && get(/databases/$(database)/documents/contratos/$(resource.data.contratoId)).data.orgaoId == orgaoDoToken();
    }

    // Qualquer usuário autenticado pode gravar seu próprio log (é como o
    // registrarLog atual funciona, direto do cliente) — mas só em nome de
    // si mesmo: sem isso, o campo "usuario" viria do cliente sem checagem
    // nenhuma, e qualquer conta autenticada poderia forjar entradas em
    // nome de outra pessoa num registro que existe justamente para
    // responsabilização. Ninguém lê, altera ou apaga — a tela de consulta
    // fica para o backlog da Fase 8.
    match /auditoria_logs/{logId} {
      allow create: if request.auth != null
        && request.resource.data.usuario == request.auth.token.email;
      // Leitura liberada a qualquer admin (não restrita ao orgaoId de quem
      // lê) — os logs não guardam orgaoId próprio hoje, e o item de
      // backlog registado no fechamento do plano de evolução (Fase 8,
      // docs/PLANO.md) já previa só "restrita a perfil == 'admin'". Um
      // admin de um órgão consegue ver ações de outro órgão nesta tela —
      // trade-off aceito por ora, não um esquecimento.
      allow read: if ehAdmin();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
