# Copie para .env (local) e preencha com valores reais.
# Nunca commitar .env com valores preenchidos — já está no .gitignore.

# --- Cliente (Vite) ---
# Config pública do Firebase Web SDK. É esperado que fique visível no
# bundle — protegida pelas Firestore Security Rules, não por sigilo.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ATENÇÃO: enquanto a Fase 2 do plano não migrar a chamada ao Gemini para
# o servidor, esta variável fica exposta no bundle público. Não é um
# "segredo de cliente" válido — é uma credencial de faturamento vazada
# por design da configuração atual. Ver docs/PLANO.md, Fase 2.
VITE_GEMINI_API_KEY=

# --- Servidor (funções em /api, lidas via process.env) ---

# JSON completo da service account do Firebase Admin (uma linha só).
FIREBASE_ADMIN_CREDENTIALS=

# Conta usada pelo cron para autenticar no Firebase Auth (client SDK).
# Migra para firebase-admin na Fase 3 do plano.
BOT_EMAIL=
BOT_PASS=

# Conta Gmail usada para enviar e-mails (criação de usuário, alertas de
# vencimento). EMAIL_PASS é uma senha de app do Gmail, não a senha da conta.
EMAIL_USER=
EMAIL_PASS=

# Opcional — e-mail(s) extra em cópia nos alertas de vencimento do cron.
EMAIL_CC=
