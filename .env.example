# Copie para .env (local) e preencha com valores reais.
# Nunca commitar .env com valores preenchidos — já está no .gitignore.

# --- Cliente (Vite) ---
# Config pública do Firebase Web SDK. É esperado que fique visível no
# bundle — protegida pelas Firestore Security Rules, não por sigilo.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Servidor (funções em /api, lidas via process.env) ---

# Chave do Gemini. Migrada para o servidor na Fase 2 — sem prefixo VITE_,
# não entra mais no bundle público. `api/extrair-documento.ts` é o único
# lugar que a lê.
GEMINI_API_KEY=

# JSON completo da service account do Firebase Admin (uma linha só). Usada
# por todos os handlers de /api, incluindo o cron-vencimentos desde a Fase 3
# (antes disso ele usava uma conta-robô via client SDK — removida).
# Também é lida por scripts/migrar-perfis.ts quando rodado localmente.
FIREBASE_ADMIN_CREDENTIALS=

# Segredo que a Vercel envia automaticamente como
# "Authorization: Bearer $CRON_SECRET" nas chamadas agendadas do cron
# (ver vercel.json). Definido aqui só para rodar o cron localmente;
# em produção a Vercel injeta o valor sozinha quando o env var existe
# no projeto.
CRON_SECRET=

# Conta Gmail usada para enviar e-mails (criação de usuário, alertas de
# vencimento). EMAIL_PASS é uma senha de app do Gmail, não a senha da conta.
EMAIL_USER=
EMAIL_PASS=

# Opcional — e-mail(s) extra em cópia nos alertas de vencimento do cron.
EMAIL_CC=
